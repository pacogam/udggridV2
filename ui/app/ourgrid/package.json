{
  "name": "ourgrid-app",
  "version": "1.3.1",
  "description": "OurGrid App",
  "author": "OpenRemote",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "exports": {
    "./*": "./lib/*.js"
  },
  "scripts": {
    "clean": "npx tsc -b --clean && npx shx rm -rf dist",
    "modelBuild": "npx orutil build",
    "modelWatch": "npx orutil watch",
    "build": "npx cross-env NODE_OPTIONS=--max_old_space_size=4096 rspack --mode production",
    "serve": "npx tsc -b --clean && npx shx rm -rf dist && npx orutil build && npx cross-env NODE_OPTIONS=--max_old_space_size=4096 rspack serve --mode development",
    "serveProd": "npx tsc -b --clean && npx shx rm -rf dist && npx orutil build && npx cross-env NODE_OPTIONS=--max_old_space_size=4096 rspack serve --mode production",
    "serveNoModelBuild": "npx tsc -b --clean && npx cross-env NODE_OPTIONS=--max_old_space_size=4096 rspack serve --mode development",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "@lit-labs/motion": "^1.0.3",
    "@lit/task": "^1.0.0",
    "@material/chips": "^14.0.0",
    "@material/circular-progress": "^14.0.0",
    "@openremote/core": "1.28.1",
    "@openremote/model": "1.28.1",
    "@openremote/or-app": "1.28.1",
    "@openremote/or-chart": "npm:~1.7.0",
    "@openremote/or-mwc-components": "1.28.1",
    "countup.js": "^2.8.0",
    "keen-slider": "^6.8.6",
    "lit": "^3.3.2",
    "lit-markdown": "^1.3.2",
    "model": "workspace:*",
    "rest": "workspace:*"
  },
  "devDependencies": {
    "@openremote/util": "1.28.1",
    "@rspack/cli": "~1.7.10",
    "@rspack/core": "~1.7.10",
    "cross-env": "^10.1.0",
    "raw-loader": "^4.0.2",
    "shx": "~0.4.0",
    "typescript": "5.8.3",
    "webpack": "^5.108.3",
    "webpack-bundle-analyzer": "^4.10.2"
  }
}
